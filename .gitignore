.vscode/

# Build output (tools/package.sh writes zips and .sha256 files here by default)
dist/
*.zip
*.sha256

# Workshop workspace - agent desks, the shared bench and the operator notes.
# These are not addon code and must never reach a release zip.
#
# tools/ is NOT ignored: the release gate, the behaviour suite and the
# mutation runner are tracked verification code. They are still excluded from
# the release zip, by the explicit manifest in tools/package.sh.
desks/
bench/*
classroom/
CAIRN.md
workshop.md
hands-up.md
